rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); } // Relaxed to avoid blocking users
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function affectedKeys(inc, ext) {
      return inc.diff(ext).addedKeys().union(inc.diff(ext).removedKeys()).union(inc.diff(ext).modifiedKeys());
    }
    
    function isSystemAdmin() {
      return isSignedIn() && (
        request.auth.uid == "rJl7x9o9YuRuWSSl4VA1j7imnmn1" ||
        request.auth.token.email == "argaming2020119@gmail.com"
      );
    }

    function isAdmin() { 
      return isSystemAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function getAdminRole() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'User') : 'User';
    }

    function hasAdminRole(role) {
      return isSignedIn() && (
        request.auth.uid == "rJl7x9o9YuRuWSSl4VA1j7imnmn1" ||
        request.auth.token.email == "argaming2020119@gmail.com" || 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == "Super Admin" ||
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == role
        ))
      );
    }

    function isTournamentManager() { return isSystemAdmin() || hasAdminRole("Tournament Manager"); }
    function isContentModerator() { return isSystemAdmin() || hasAdminRole("Content Moderator"); }
    function isHeadScout() { return isSystemAdmin() || hasAdminRole("Head Scout"); }
    function isSuperAdmin() { return isSystemAdmin() || hasAdminRole("Super Admin"); }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             (data.get('ign', '') is string) &&
             (data.get('systemId', '') is string) &&
             (data.get('role', 'User') is string) &&
             (data.get('division', '') is string) &&
             (data.get('teamId', '') is string) &&
             (data.get('teamName', '') is string) &&
             (data.get('updatedAt', request.time) == request.time);
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['uid', 'ign', 'game', 'fullName', 'name', 'createdAt', 'status']) &&
             data.uid == request.auth.uid &&
             data.status == 'pending' &&
             data.createdAt == request.time &&
             data.fullName is string && data.fullName.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.ign is string && data.ign.size() <= 64 &&
             data.game is string && data.game.size() <= 64 &&
             (data.get('valorantId', '') is string && data.get('valorantId', '').size() <= 128) &&
             (data.get('mainAgent', '') is string && data.get('mainAgent', '').size() <= 64) &&
             (data.get('device', '') is string && data.get('device', '').size() <= 128);
    }

    function isValidTournament(data) {
      return data.keys().hasAll(['name', 'game', 'slots', 'total', 'status']) &&
             data.name is string && data.name.size() <= 200 &&
             data.game is string && data.game.size() <= 100 &&
             (data.get('map', '') is string && data.get('map', '').size() <= 100) &&
             data.slots is int && data.total is int &&
             data.status in ['upcoming', 'open', 'closed', 'ongoing', 'finished'];
    }

    function isValidResult(data) {
      return data.keys().hasAll(['tournamentId', 'teamName', 'rank']) &&
             data.tournamentId is string &&
             data.teamName is string && data.teamName.size() <= 128 &&
             data.rank is int && data.rank >= 1 && data.rank <= 50;
    }

    function isValidHighlight(data) {
      return data.keys().hasAll(['title', 'thumb']) &&
             data.title is string && data.title.size() <= 200 &&
             data.thumb is string && data.thumb.size() <= 500;
    }

    function isValidSquadMember(data) {
      return data.keys().hasAll(['ign', 'role', 'div']) &&
             data.ign is string && data.ign.size() <= 64 &&
             data.role is string && data.role.size() <= 64 &&
             data.div is string && data.div.size() <= 64 &&
             (data.get('systemId', '') is string) &&
             (data.get('instagram', '') is string) &&
             (data.get('youtube', '') is string) &&
             (data.get('discord', '') is string) &&
             (data.get('squadNumber', '') is string);
    }

    function isValidDivision(data) {
      return data.keys().hasAll(['key', 'name']) &&
             data.key is string && data.key.size() <= 50 &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidAchievement(data) {
      return data.keys().hasAll(['title', 'imageUrl', 'date']) &&
             data.title is string && data.title.size() <= 200 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             data.date is string && data.date.size() <= 100 &&
             (data.get('game', '') is string) &&
             (data.get('division', '') is string) &&
             (data.get('description', '') is string);
    }

    function isValidStaff(data) {
      return data.keys().hasAll(['name', 'role']) &&
             data.name is string && data.name.size() <= 128 &&
             data.role is string && data.role.size() <= 128 &&
             (data.get('desc', '') is string && data.get('desc', '').size() <= 1000) &&
             (data.get('image', '') is string && data.get('image', '').size() <= 1000) &&
             (data.get('order', 0) is int || data.get('order', 0) is number) &&
             (data.get('updatedAt', request.time) == request.time);
    }

    function isValidScrim(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string && data.title.size() <= 200;
    }

    function isValidRegistration(data, tId) {
      return data.uid == request.auth.uid &&
             data.status == 'pending' &&
             data.teamName is string &&
             data.ign is string &&
             data.playerId is string;
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['round', 'type', 'team1', 'team2', 'status']) &&
             data.round is int &&
             data.type in ['upper', 'lower', 'grand_final'] &&
             data.status in ['scheduled', 'live', 'completed'] &&
             data.team1 is map &&
             data.team2 is map &&
             (data.team1.get('id', '') is string) &&
             (data.team1.get('name', '') is string) &&
             (data.team2.get('id', '') is string) &&
             (data.team2.get('name', '') is string);
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if (isSignedIn() && isOwner(userId) && isValidUser(incoming()) &&
                    affectedKeys(incoming(), existing()).hasOnly(['ign', 'role', 'division', 'kd', 'matches', 'updatedAt', 'teamId', 'teamName', 'systemId', 'email', 'uid', 'createdAt']) &&
                    (incoming().get('updatedAt', request.time) == request.time) &&
                    (incoming().uid == existing().uid) &&
                    (incoming().email == existing().email) &&
                    (!existing().keys().hasAll(['createdAt']) || incoming().createdAt == existing().createdAt)
                    ) || isAdmin();
    }

    match /squad/{memberId} {
      allow read: if true;
      allow create: if isHeadScout() && isValidSquadMember(incoming());
      allow update: if (isHeadScout() && isValidSquadMember(incoming())) || 
                      (isSignedIn() && 
                       resource.data.uid == request.auth.uid && 
                       incoming().get('uid', '') == existing().get('uid', '') && 
                       incoming().get('role', '') == existing().get('role', '') && 
                       incoming().get('div', '') == existing().get('div', '') &&
                       isValidSquadMember(incoming()) &&
                       affectedKeys(incoming(), existing()).hasOnly(['ign', 'instagram', 'youtube', 'discord', 'updatedAt', 'squadNumber']));
      allow delete: if isHeadScout();
    }

    match /scrims/{scrimId} {
      allow read: if true;
      allow create, update, delete: if isContentModerator() && isValidScrim(incoming());
    }

    match /divisions/{divisionId} {
      allow read: if true;
      allow create, update, delete: if isContentModerator() && isValidDivision(incoming());
    }

    match /applications/{appId} {
      allow get: if (isSignedIn() && (resource == null || resource.data.uid == request.auth.uid)) || isAdmin();
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin(); 
      allow create: if isSignedIn() && isValidId(appId) && isValidApplication(incoming());
      allow update, delete: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isTournamentManager() && isValidTournament(incoming()) && (incoming().get('createdAt', request.time) == request.time);
        allow update: if (isTournamentManager() && isValidTournament(incoming()) && (incoming().get('updatedAt', request.time) == request.time)) ||
                      (isSignedIn() && affectedKeys(incoming(), existing()).hasOnly(['slots']));
      allow delete: if isTournamentManager();

      match /registrations/{regId} {
        allow read: if true;
        allow create: if isSignedIn() && regId == request.auth.uid && isValidRegistration(incoming(), tournamentId);
        allow update: if isTournamentManager();
        allow delete: if isTournamentManager() || (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
      }

      match /matches/{matchId} {
        allow read: if true;
        allow create: if isTournamentManager() && isValidMatch(incoming());
        allow update: if isTournamentManager() && isValidMatch(incoming());
        allow delete: if isTournamentManager();
      }
    }

    match /{path=**}/registrations/{regId} {
      allow read: if true;
    }

    match /{path=**}/matches/{matchId} {
      allow read: if true;
    }

    match /results/{resultId} {
      allow read: if true;
      allow create: if isTournamentManager() && isValidResult(incoming()) && (incoming().get('createdAt', request.time) == request.time);
      allow update: if isTournamentManager() && isValidResult(incoming()) && (incoming().get('updatedAt', request.time) == request.time);
      allow delete: if isTournamentManager();
    }

    match /highlights/{highlightId} {
      allow read: if true;
      allow create: if isContentModerator() && isValidHighlight(incoming()) && (incoming().get('createdAt', request.time) == request.time);
      allow update: if isContentModerator() && isValidHighlight(incoming()) && (incoming().get('updatedAt', request.time) == request.time);
      allow delete: if isContentModerator();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow create: if isContentModerator() && isValidAchievement(incoming()) && (incoming().get('createdAt', request.time) == request.time);
      allow update: if isContentModerator() && isValidAchievement(incoming()) && (incoming().get('updatedAt', request.time) == request.time);
      allow delete: if isContentModerator();
    }

    match /staff/{staffId} {
      allow read: if true;
      allow create: if isSuperAdmin() && isValidStaff(incoming()) && (incoming().get('createdAt', request.time) == request.time);
      allow update: if isSuperAdmin() && isValidStaff(incoming());
      allow delete: if isSuperAdmin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if isVerified();
      allow update, delete: if isAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid);

      match /members/{memberId} {
        allow read: if true;
        allow create: if isVerified() && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid ||
          request.auth.uid == memberId
        );
        allow delete: if isAdmin() || (isSignedIn() && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid ||
          request.auth.uid == memberId
        ));
      }

      match /requests/{requestId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid || 
          (resource == null || resource.data.uid == request.auth.uid)
        );
        allow create: if isVerified() && incoming().uid == request.auth.uid;
        allow update: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid);
        allow delete: if isAdmin() || (isSignedIn() && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid || 
          resource.data.uid == request.auth.uid
        ));
      }
    }

    match /admins/{userId} {
      allow read: if isSignedIn();
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin(); 
    }

    match /test/connection {
      allow read: if true;
    }

    match /site_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /player_screenshot_stats/{statId} {
      allow read: if true;
      allow create: if isVerified();
      allow delete: if isVerified();
    }
  }
}
